<PreferenceScreen
    android:key="setting_gamepad_screen"
    android:summary="@string/preference_description_physical_gamepad_bricks"
    android:title="@string/preference_title_enable_physical_gamepad_bricks"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="setting_physical_gamepad_bricks"
        android:summary="@string/preference_gamepad_enable_bricks"
        android:title="@string/preference_title_enable_physical_gamepad_bricks" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:dependency="setting_physical_gamepad_bricks"
        android:key="setting_gamepad_swap_face_buttons"
        android:summary="@string/preference_description_gamepad_swap_face_buttons"
        android:title="@string/preference_title_gamepad_swap_face_buttons" />

</PreferenceScreen>
